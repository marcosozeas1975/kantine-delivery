# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token provided by @BotFather.
# Configure as a secret or environment variable. Server-side only.
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# ADMIN_API_KEY: chave administrativa para scripts/testes (mínimo 20 caracteres). Opcional:
# sem ela, o painel só abre com login Google autorizado. Não existe mais chave padrão.
ADMIN_API_KEY="MY_ADMIN_API_KEY"

# ADMIN_EMAILS: e-mails (Google) com acesso ao painel administrativo, separados por vírgula.
# Obrigatória: sem ela nenhum login Google é aceito.
ADMIN_EMAILS="pessoa1@exemplo.com,pessoa2@exemplo.com"

# MERCADO_PAGO_ACCESS_TOKEN: Production or Test Access Token from Mercado Pago Developers.
# Starts with APP_USR-... (Production) or TEST-... (Sandbox). Server-side only.
MERCADO_PAGO_ACCESS_TOKEN="MY_MERCADO_PAGO_ACCESS_TOKEN"

# MERCADO_PAGO_PUBLIC_KEY: Public key for client-side Mercado Pago components (optional).
MERCADO_PAGO_PUBLIC_KEY="MY_MERCADO_PAGO_PUBLIC_KEY"

# OFFER_LEAD_MINUTES: antecedência (min) com que a oferta agendada é publicada aos entregadores. Padrão 90.
OFFER_LEAD_MINUTES="90"
